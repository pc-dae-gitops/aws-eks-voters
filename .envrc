export top_level=$(git rev-parse --show-toplevel)
export target_path="./local-cluster"
# Update if mac-k8s repo is not located in the same directory as this repository
export utils_dir="$(realpath ${top_level}/../mac-k8s)"
export config_dir="$(realpath ${top_level}/../mac-k8s)"
export global_config_branch=main

if [ -f resources/.vault-init.json ]; then
  export VAULT_TOKEN=$(jq -r '."root_token"' resources/.vault-init.json)
fi

export local_dns=kubernetes.local.internal # Ingress domain of the local cluster running tofu-controller

export VAULT_ADDR=https://vault.${local_dns}

export GITHUB_GLOBAL_CONFIG_ORG=pc-dae-gitops # Update if needed
export GITHUB_GLOBAL_CONFIG_REPO=mac-k8s # Update if needed

# Update the following values to match your environment.
export GITHUB_SERVER=github.com
export GITHUB_MGMT_ORG=pc-dae-gitops
export GITHUB_MGMT_REPO=aws-eks-voters
export GITHUB_MGMT_BRANCH=main # Branch of the cluster repository Flux deploys, check it out before running setup.sh
export USER_EMAIL=paul.carlton@dae.mn
export GITHUB_USER=paul-carlton
export REGISTRY=paulcalrtondae
export FLUX_VERSION=v2.9
export DOCKERHUB_USER=${REGISTRY} # Set to your DockerHub username, used by mirror.sh to increase docker.io pull rate limit
export DOCKERHUB_TOKEN=${DOCKERHUB_CREDS:-}

# EKS target cluster, created by setup.sh --kind --target eks, see eks_target_env in mac-k8s bin/lib.sh for the
# other settings and their defaults. AWS credentials are in creds/aws.sh, not in git, see mac-k8s bin/aws-creds.sh
export AWS_REGION=eu-west-1
export EKS_CLUSTER_NAME=voters

[ -f $HOME/.bash_creds.sh ] && source $HOME/.bash_creds.sh
[ -f $utils_dir/bin/lib.sh ] && source $utils_dir/bin/lib.sh
add_to_path ${utils_dir}/bin
